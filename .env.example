# Required for real AI replies
MODEL_API_KEY=sk-...
MODEL_API_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# Owner login — server-side only. Generate a long password and 64 random secret bytes.
APP_LOGIN_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=28800

# Optional read-only GitHub inspection (server-side only; exact repo allowlist)
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=

# Frontend API URL (HTTPS in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000,https://agent-phone.netlify.app

# Crypto Intelligence Stage 1 (read-only)
CRYPTO_PROVIDER=fixture
