# Required for real AI replies
MODEL_API_KEY=sk-...
MODEL_API_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# Auth — MUST change in production (long random string)
APP_AUTH_TOKEN=change-me-to-a-long-random-string

# Frontend: public API URL (HTTPS in production)
# Baked into the Next.js build — rebuild after changing
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional
DATA_DIR=./data
