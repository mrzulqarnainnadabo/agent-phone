# Required for real AI replies
MODEL_API_KEY=sk-...
MODEL_API_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# Auth – change this in production
APP_AUTH_TOKEN=change-me-to-a-long-random-string

# Frontend must point to the public API URL in production
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional
DATA_DIR=./data
